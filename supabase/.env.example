# Copy to supabase/.env (gitignored). Used by `npx supabase functions serve --env-file supabase/.env`.
# Never commit real values.

SUPABASE_DB_PASSWORD=

# Face / ID verifier (Docker on this PC). Must be host.docker.internal from edge runtime.
FACE_VERIFY_SERVICE_URL=http://host.docker.internal:8090
FACE_VERIFY_SERVICE_KEY=

# Auth emails (server only — never put this in Vite/Expo public env)
RESEND_API_KEY=

# Optional: required in production if these functions are exposed without a user JWT
STORAGE_CLEANUP_HOOK_SECRET=
REQUEST_CODE_HOOK_SECRET=
