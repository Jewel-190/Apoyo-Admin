# Copy to ".env" in this folder (gitignored). Used by Vite + optional Supabase CLI.

# --- Vite (public anon key only — never put service_role here) ---
VITE_SUPABASE_URL=https://api.apoyo-dasma.online
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# --- Supabase CLI (required for: db query --linked, db push, db pull, etc.) ---
# Same value as: Dashboard → Project Settings → Database → Database password
# Without this, the CLI fails with SASL / cli_login_postgres / ECIRCUITBREAKER on the pooler.
SUPABASE_DB_PASSWORD=

# --- Optional: non-interactive login (no browser / verification code) ---
# Create at: https://supabase.com/dashboard/account/tokens
# Then run once: npx supabase login --token "YOUR_ACCESS_TOKEN"
# SUPABASE_ACCESS_TOKEN=
